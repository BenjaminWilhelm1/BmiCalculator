<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:BmiCalculator"
             x:Class="BmiCalculator.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <!-- Hard code colors cool! -->
            <Color x:Key="PrimaryColor">#2B1B6E</Color>
            <Color x:Key="AccentColor">#E91E63</Color>
            <Color x:Key="MaleColor">#42A5F5</Color> <!-- Dudes get blue -->
            
        </ResourceDictionary>
    </Application.Resources>
</Application>
