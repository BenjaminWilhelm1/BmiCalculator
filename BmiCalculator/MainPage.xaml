<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BmiCalculator.MainPage"
             Title="BMI Calculator"  
             BackgroundColor="#F0F0F0">
             
    
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">
            <!-- Gender  -->
            <Grid ColumnDefinitions="*,20,*" HeightRequest="160">

                <!-- Male  -->
                <Frame x:Name="MaleFrame"
                       Grid.Column="0"
                       CornerRadius="12"
                       Padding="10"
                       HasShadow="True"
                       BackgroundColor="White"
                       BorderColor="Transparent">
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnMaleTapped" />
                    </Frame.GestureRecognizers>
                    <VerticalStackLayout HorizontalOptions="Center"
                                         VerticalOptions="Center"
                                         Spacing="8">
                        <Label Text="🚹"
                               FontSize="60"
                               HorizontalOptions="Center"
                               x:Name="MaleIcon" />
                        <Label Text="Male"
                               FontSize="18"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"
                               TextColor="#333333" />
                    </VerticalStackLayout>
                </Frame>

                <!-- Female  -->
                <Frame x:Name="FemaleFrame"
                       Grid.Column="2"
                       CornerRadius="12"
                       Padding="10"
                       HasShadow="True"
                       BackgroundColor="White"
                       BorderColor="Transparent">
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnFemaleTapped" />
                    </Frame.GestureRecognizers>
                    <VerticalStackLayout HorizontalOptions="Center"
                                         VerticalOptions="Center"
                                         Spacing="8">
                        <Label Text="🚺"
                               FontSize="60"
                               HorizontalOptions="Center"
                               x:Name="FemaleIcon" />
                        <Label Text="Female"
                               FontSize="18"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"
                               TextColor="#333333" />
                    </VerticalStackLayout>
                </Frame>
            </Grid>

            <!-- height slider -->
            <Frame CornerRadius="12"
                   Padding="20"
                   HasShadow="True"
                   BackgroundColor="White"
                   BorderColor="Transparent">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Height (inches)"
                           FontSize="16"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"
                           TextColor="#333333" />
                    <Slider x:Name="HeightSlider"
                            Minimum="0"
                            Maximum="100"
                            Value="50"
                            MinimumTrackColor="#E91E63"
                            MaximumTrackColor="#DDDDDD"
                            ThumbColor="#E91E63"
                            ValueChanged="OnHeightSliderChanged" />
                    <Label x:Name="HeightValueLabel"
                           Text="50"
                           FontSize="22"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"
                           TextColor="#333333" />
                </VerticalStackLayout>
            </Frame>

            <!-- Weight slider -->
            <Frame CornerRadius="12"
                   Padding="20"
                   HasShadow="True"
                   BackgroundColor="White"
                   BorderColor="Transparent">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Weight (lbs)"
                           FontSize="16"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"
                           TextColor="#333333" />
                    <Slider x:Name="WeightSlider"
                            Minimum="0"
                            Maximum="300"
                            Value="90"
                            MinimumTrackColor="#E91E63"
                            MaximumTrackColor="#DDDDDD"
                            ThumbColor="#E91E63"
                            ValueChanged="OnWeightSliderChanged" />
                    <Label x:Name="WeightValueLabel"
                           Text="90"
                           FontSize="22"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"
                           TextColor="#333333" />
                </VerticalStackLayout>
            </Frame>

            <!-- Calc Button -->
            <Button Text="Calculate your BMI"
                    FontSize="18"
                    FontAttributes="Bold"
                    BackgroundColor="#2B1B6E"
                    TextColor="White"
                    CornerRadius="12"
                    HeightRequest="55"
                    Clicked="OnCalculateBmiClicked" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
